{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=ouehzbkiyutfsfjeaonq",
      "enabled": true
    }
  },
  "mcpServers": {
    "qf-api": {
      "command": "npx",
      "args": ["tsx", ".mcp/index.ts"],
      "env": {
        "QF_CLIENT_ID": "${QF_CLIENT_ID}",
        "QF_CLIENT_SECRET": "${QF_CLIENT_SECRET}",
        "QF_API_BASE": "${QF_API_BASE}",
        "QF_OAUTH_TOKEN_URL": "${QF_OAUTH_TOKEN_URL}"
      }
    }
  }
}

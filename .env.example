# Qayra Environment Variables

# ============================================
# SUPABASE
# Get from: https://supabase.com/dashboard/settings/api
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# ============================================
# QURAN FOUNDATION
# Get from: https://developer.quran.foundation
# ============================================
QF_CLIENT_ID=your-client-id
QF_CLIENT_SECRET=your-client-secret

# ============================================
# ENVIRONMENT: prelive | live
# ============================================
# prelive: Testing environment (has User APIs)
# live:   Production environment
#
# To switch:
#   - Set QF_ENV=prelive  -> uses prelive APIs
#   - Set QF_ENV=live    -> uses production APIs
# ============================================
QF_ENV=prelive

# ============================================
# OPTIONAL OVERRIDES
# Usually NOT needed - auto-configured based on QF_ENV
# ============================================

# Translation IDs (comma-separated)
# Default: 85 (Abdel Haleem English)
# QF_TRANSLATION_IDS=85,131

# API Bases (usually auto-set from QF_ENV)
# Uncomment only if needed:
# QF_API_BASE=https://apis-prelive.quran.foundation
# QF_USER_API_BASE=https://apis-prelive.quran.foundation
# QF_OAUTH_TOKEN_URL=https://prelive-oauth2.quran.foundation/oauth2/token

# Production (uncomment both ENV + URLs):
# QF_ENV=live
# QF_API_BASE=https://apis.quran.foundation
# QF_USER_API_BASE=https://api.quran.foundation
# QF_OAUTH_TOKEN_URL=https://oauth2.quran.foundation/oauth2/token
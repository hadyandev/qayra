# Qayra Environment Variables

# ============================================
# SUPABASE (for notes storage)
# Get from: https://supabase.com/dashboard
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# ============================================
# QURAN FOUNDATION — User API (OAuth, activity, streaks)
# Use credentials issued by Quran Foundation for your environment.
# For local testing with User APIs, use prelive credentials.
# ============================================
QF_CLIENT_ID=your-client-id
QF_CLIENT_SECRET=your-client-secret

# ============================================
# QURAN FOUNDATION — Content API (chapters, verses, tafsir)
# Separate credentials for Content API. Can use production
# even when User API is on prelive.
# ============================================
QF_CONTENT_CLIENT_ID=your-content-client-id
QF_CONTENT_CLIENT_SECRET=your-content-client-secret
QF_CONTENT_API_BASE=https://apis.quran.foundation

# ============================================
# ENVIRONMENT: prelive | production
# ============================================
# Controls User API environment, PRELIVE badge, and prelive restrictions.
# Content API uses separate credentials above.
#
QF_ENV=prelive

# User API scopes requested during OAuth login.
# Must match the scopes Quran Foundation enabled for your OAuth client.
QF_OAUTH_SCOPES="openid offline_access activity_day streak"

# ============================================
# OAUTH CALLBACK (required for OAuth2 flow)
# ============================================
# The redirect URI after OAuth login
# MUST be registered in QF developer portal for your client
#
# Development / prelive:
QF_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
#
# Production:
# QF_OAUTH_REDIRECT_URI=https://your-domain.com/oauth/callback

# ============================================
# OPTIONAL OVERRIDES
# Usually NOT needed - auto-configured based on QF_ENV
# ============================================
# Translation IDs (comma-separated)
# Default: 85 (Abdel Haleem English)
# QF_TRANSLATION_IDS=85,131

# User API base URL - auto-selected from QF_ENV:
#   prelive:  https://apis-prelive.quran.foundation
#   production: https://apis.quran.foundation
#
# Uncomment only if you need custom URLs:
# QF_USER_API_BASE=https://apis-prelive.quran.foundation
# QF_OAUTH_TOKEN_URL=https://prelive-oauth2.quran.foundation/oauth2/token

# Qayra Environment Variables

# ============================================
# SUPABASE (for notes storage)
# Get from: https://supabase.com/dashboard
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# ============================================
# QURAN FOUNDATION OAuth2
# Get from: https://developer.quran.foundation
# ============================================
# Confidential client (has client_secret)
QF_CLIENT_ID=your-client-id
QF_CLIENT_SECRET=your-client-secret

# OR for Public client (no client_secret):
# QF_CLIENT_ID=your-client-id
# QF_CLIENT_SECRET=

# ============================================
# ENVIRONMENT: prelive | live
# ============================================
# prelive: Testing - has ALL User APIs (activity, bookmarks, goals, etc.)
# live:   Production - may not have all User APIs yet
#
# When switching to 'live', update optional overrides below
#
QF_ENV=prelive

# ============================================
# OAUTH CALLBACK (required for OAuth2 flow)
# ============================================
# The redirect URI after OAuth login
# MUST be registered in QF developer portal for your client
#
# Development:
# QF_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
#
# Production:
# QF_OAUTH_REDIRECT_URI=https://your-domain.com/oauth/callback

# ============================================
# OPTIONAL OVERRIDES
# Usually NOT needed - auto-configured based on QF_ENV
# ============================================
# Translation IDs (comma-separated)
# Default: 85 (Abdel Haleem English)
# QF_TRANSLATION_IDS=85,131

# Base URLs - auto-selected from QF_ENV:
#   prelive:  https://apis-prelive.quran.foundation
#   live:     https://apis.quran.foundation
#
# Uncomment only if you need custom URLs:
# QF_API_BASE=https://apis-prelive.quran.foundation
# QF_USER_API_BASE=https://apis-prelive.quran.foundation
# QF_OAUTH_TOKEN_URL=https://prelive-oauth2.quran.foundation/oauth2/token

# ============================================
# PRODUCTION SETTINGS (when QF_ENV=live)
# ============================================
# QF_ENV=live
# QF_API_BASE=https://apis.quran.foundation
# QF_OAUTH_TOKEN_URL=https://oauth2.quran.foundation/oauth2/token
# QF_OAUTH_REDIRECT_URI=https://your-production-domain.com/oauth/callback
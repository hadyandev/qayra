# Qayra Environment Variables

# Supabase (Required for database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Quran Foundation API (Server-side only - for proxy)
# Get API key from: https://quran.foundation/developers
QF_API_BASE_URL=https://api.quran.foundation
QF_API_KEY=your-qf-api-key

# Quran Foundation OAuth (Optional - for publishing)
QF_CLIENT_ID=your-client-id
QF_CLIENT_SECRET=your-client-secret
QF_REDIRECT_URI=https://your-domain.com/api/auth/callback
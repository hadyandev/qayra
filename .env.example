# Qayra Environment Variables

# Supabase (for reflections storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Quran Foundation OAuth2 (for Search API)
# Get these from Quran Foundation developer portal
QF_CLIENT_ID=your-client-id
QF_CLIENT_SECRET=your-client-secret

# Optional: Legacy API key if using v4 content APIs
QF_API_KEY=optional-api-key
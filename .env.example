# Qayra Environment Variables

# Supabase (for reflections storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Quran Foundation OAuth2 (for Content & Search APIs)
# Get these from Quran Foundation developer portal
QF_CLIENT_ID=your-client-id
QF_CLIENT_SECRET=your-client-secret

# Optional: Override default translation IDs (comma-separated)
# Default is 85 (Abdel Haleem English translation)
# Get IDs from: GET /content/api/v4/resources/translations
# QF_TRANSLATION_IDS=85,131

# Optional: Override API base URLs
# QF_API_BASE=https://apis-prelive.quran.foundation
# QF_OAUTH_TOKEN_URL=https://prelive-oauth2.quran.foundation/oauth2/token
